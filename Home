<script>
window.IMG_AMERICANO = "";
window.IMG_BAG = "";
window.IMG_ROAST = "";
window.IMG_SPECIALTY = "";
window.IMG_MERCH = "";
window.IMG_GIFT = "";
const SHOP_URL = "https://shopee.co.th/macnuts.coffee";

/* nav shadow on scroll */
const nav = document.getElementById("nav");
window.addEventListener("scroll", () => {
  nav.classList.toggle("scrolled", window.scrollY > 8);
}, {passive:true});

/* marquee facts */
const facts = ["100% ARABICA","ไม่มีน้ำตาล","ดอยช้าง เชียงใหม่","ส่งไว 2–3 วัน","เก็บเงินปลายทาง","ทำสดใหม่ทุกวัน"];
const track = document.getElementById("marqueeTrack");
track.innerHTML = Array(2).fill(facts.map(f => `<span>${f}</span>`).join("")).join("");

/* more grid */
const MORE = [
  { title:"Cold Brew Americano", tag:"พร้อมดื่ม", img:"IMG_AMERICANO" },
  { title:"Cold Brew Bag", tag:"ชงเองที่บ้าน", img:"IMG_BAG" },
  { title:"เมล็ดกาแฟคั่ว", tag:"Doi Chang · Huay Chompu", img:"IMG_ROAST" },
  { title:"Yuzu · ชาสมุนไพร", tag:"ไซรัปยูซุ, ชาเลือดมังกร", img:"IMG_SPECIALTY" },
  { title:"Merchandise", tag:"แก้ว, เชคเกอร์, กระเป๋าผ้า", img:"IMG_MERCH" },
  { title:"Gift Set", tag:"เซ็ตของขวัญพรีเมียม", img:"IMG_GIFT" },
];
const grid = document.getElementById("moreGrid");
MORE.forEach(item => {
  const a = document.createElement("a");
  a.className = "tile"; a.href = item.link || SHOP_URL;
  a.target = "_blank"; a.rel = "noopener";
  a.setAttribute("data-reveal","");
  a.innerHTML = `
    <div class="tile-img"><img src="data:image/jpeg;base64,${window[item.img]}" alt="${item.title}"></div>
    <div class="tile-cap">
      <div><h3>${item.title}</h3><span>${item.tag}</span></div>
      <div class="tile-arrow"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6"><path d="M7 17L17 7M17 7H8M17 7V16"/></svg></div>
    </div>`;
  grid.appendChild(a);
});

/* reveal on scroll */
const io = new IntersectionObserver((entries) => {
  entries.forEach((en,i) => {
    if (en.isIntersecting) {
      setTimeout(()=>en.target.classList.add("in"), i*40 % 200);
      io.unobserve(en.target);
    }
  });
}, {threshold:0.12});
document.querySelectorAll("[data-reveal]").forEach(el => io.observe(el));
</script>
