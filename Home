<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Macnuts Coffee</title>
<meta name="description" content="Macnuts Coffee — กาแฟสกัดเย็น อราบิก้า 100% จากดอยช้าง เชียงใหม่">
<link rel="apple-touch-icon" href="data:image/png;base64,">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Thai:wght@300;400;500;600;700&family=JetBrains+Mono:wght@500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#FFFFFF;
    --bg-soft:#F5F5F7;
    --ink:#1D1D1F;
    --ink-soft:#6E6E73;
    --navy:#0E2340;
    --navy-2:#152C4E;
    --line: rgba(0,0,0,.08);
    --line-on-navy: rgba(255,255,255,.14);
    --white:#F5F5F7;
    --ease: cubic-bezier(.16,1,.3,1);
  }
  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    margin:0; background:var(--bg); color:var(--ink);
    font-family:'IBM Plex Sans Thai',-apple-system,sans-serif;
    -webkit-font-smoothing:antialiased; font-weight:400;
  }
  a{color:inherit;text-decoration:none;}
  img{max-width:100%;display:block;}
  svg{display:block;}
  h1,h2,h3{margin:0; font-weight:600; letter-spacing:-0.02em;}
  .wrap{max-width:1180px; margin:0 auto; padding:0 24px;}
  .mono{font-family:'JetBrains Mono',monospace;}

  /* -------- nav -------- */
  .nav{
    position:sticky; top:0; z-index:80; background:rgba(255,255,255,.82);
    backdrop-filter:blur(14px); -webkit-backdrop-filter:blur(14px);
    border-bottom:1px solid transparent; transition:border-color .3s ease;
  }
  .nav.scrolled{border-bottom-color:var(--line);}
  .nav-inner{
    max-width:1180px; margin:0 auto; padding:0 24px; height:52px;
    display:flex; align-items:center; justify-content:space-between;
  }
  .nav-brand{display:flex; align-items:center; gap:9px;}
  .nav-brand img{width:22px;height:22px;border-radius:50%;}
  .nav-brand span{font-size:14.5px; font-weight:600; letter-spacing:-0.01em;}
  .nav-links{display:flex; gap:28px; align-items:center;}
  .nav-links a{font-size:12.5px; color:var(--ink-soft); font-weight:500; white-space:nowrap;}
  .nav-links a:hover{color:var(--ink);}
  .nav-cta{
    background:var(--navy); color:#fff; font-size:12.5px; font-weight:600;
    padding:7px 16px; border-radius:100px;
  }
  .nav-scroll-links{display:none;}
  @media (max-width:860px){
    .nav-links{display:none;}
  }

  /* -------- hero -------- */
  .hero{padding:76px 24px 0; text-align:center;}
  .eyebrow{
    font-family:'JetBrains Mono',monospace; font-size:11px; font-weight:600;
    letter-spacing:.12em; text-transform:uppercase; color:var(--ink-soft); margin-bottom:18px;
  }
  .hero h1{
    font-size:clamp(34px,7vw,68px); line-height:1.06; letter-spacing:-0.03em;
    max-width:16ch; margin:0 auto; color:var(--ink);
  }
  .hero p.lead{
    font-size:clamp(15px,2vw,19px); color:var(--ink-soft); max-width:38ch; margin:20px auto 0;
    line-height:1.6; font-weight:400;
  }
  .btnrow{display:flex; gap:14px; justify-content:center; margin-top:32px; flex-wrap:wrap;}
  .btn{
    display:inline-flex; align-items:center; gap:6px;
    padding:12px 24px; border-radius:100px; font-size:14.5px; font-weight:600;
    transition:transform .25s var(--ease), opacity .25s ease;
  }
  .btn-solid{background:var(--navy); color:#fff;}
  .btn-solid:hover{transform:translateY(-1px); opacity:.9;}
  .btn-text{color:var(--navy); gap:5px;}
  .btn-text svg{width:13px;height:13px; transition:transform .25s var(--ease);}
  .btn-text:hover svg{transform:translateX(3px);}

  .hero-shot{
    max-width:1180px; margin:56px auto 0; padding:0 24px 0;
  }
  .hero-shot-inner{
    position:relative; border-radius:28px; overflow:hidden;
    box-shadow:0 40px 80px -30px rgba(14,35,64,.35);
    aspect-ratio:16/9;
  }
  .hero-shot-inner img{width:100%;height:100%;object-fit:cover; object-position:center 30%;}

  /* -------- marquee facts -------- */
  .marquee{
    background:var(--bg-soft); padding:18px 0; margin-top:64px;
    overflow:hidden; white-space:nowrap; border-top:1px solid var(--line); border-bottom:1px solid var(--line);
  }
  .marquee-track{display:inline-flex; gap:0; animation:scroll 26s linear infinite;}
  .marquee span{
    font-size:12.5px; font-weight:500; color:var(--ink-soft); padding:0 22px;
    display:inline-flex; align-items:center; gap:22px;
  }
  .marquee span::after{content:"·"; color:var(--ink-soft); opacity:.5;}
  @keyframes scroll{ from{transform:translateX(0);} to{transform:translateX(-50%);} }

  /* -------- feature sections -------- */
  .feature{padding:96px 24px;}
  .feature.on-navy{background:var(--navy); color:#fff;}
  .feature.on-soft{background:var(--bg-soft);}
  .feature-head{max-width:640px; margin:0 auto; text-align:center;}
  .feature .eyebrow.inv{color:rgba(255,255,255,.6);}
  .feature h2{
    font-size:clamp(28px,4.4vw,44px); line-height:1.1; letter-spacing:-0.02em; margin-top:6px;
  }
  .feature p.sub{
    font-size:15.5px; margin-top:14px; line-height:1.65; max-width:44ch; margin-inline:auto;
    color:var(--ink-soft); font-weight:400;
  }
  .feature.on-navy p.sub{color:rgba(245,245,247,.7);}
  .feature-shot{
    max-width:1040px; margin:52px auto 0; border-radius:24px; overflow:hidden;
    box-shadow:0 30px 60px -28px rgba(0,0,0,.28);
    background:#F0EAE0;
  }
  .feature-shot img{width:100%; height:100%; object-fit:cover; display:block;}
  .feature-cta{
    display:inline-flex; align-items:center; gap:6px; margin-top:28px;
    font-size:14px; font-weight:600; color:var(--navy);
  }
  .feature.on-navy .feature-cta{color:#fff;}
  .feature-cta svg{width:13px;height:13px; transition:transform .25s var(--ease);}
  .feature-cta:hover svg{transform:translateX(3px);}

  /* side-by-side feature variant */
  .feature-split{
    max-width:1180px; margin:0 auto; display:grid; grid-template-columns:1fr; gap:36px; align-items:center;
  }
  .feature-split .fs-text{text-align:left;}
  .feature-split .fs-text p.sub{margin-inline:0;}
  .feature-split .fs-img{border-radius:24px; overflow:hidden; box-shadow:0 30px 60px -28px rgba(0,0,0,.25); aspect-ratio:4/5;}
  .feature-split .fs-img img{width:100%; height:100%; object-fit:cover; display:block;}
  @media (min-width:900px){
    .feature-split{grid-template-columns:0.85fr 1.15fr; gap:64px;}
    .feature-split.rev{grid-template-columns:1.15fr 0.85fr;}
    .feature-split.rev .fs-img{order:-1;}
  }

  /* -------- more grid -------- */
  .more{padding:96px 24px;}
  .more-head{text-align:center; max-width:560px; margin:0 auto 48px;}
  .more-head h2{font-size:clamp(26px,3.6vw,36px);}
  .more-head p{color:var(--ink-soft); font-size:14.5px; margin-top:10px;}
  .grid{
    max-width:1180px; margin:0 auto; display:grid; grid-template-columns:repeat(2,1fr); gap:20px 18px;
  }
  @media (min-width:700px){ .grid{grid-template-columns:repeat(3,1fr);} }
  .tile{display:block;}
  .tile-img{
    border-radius:18px; overflow:hidden; aspect-ratio:1/1; background:var(--bg-soft);
    transition:transform .35s var(--ease);
  }
  .tile:hover .tile-img{transform:scale(1.015);}
  .tile-img img{width:100%;height:100%;object-fit:cover; transition:transform .5s var(--ease);}
  .tile:hover .tile-img img{transform:scale(1.05);}
  .tile-cap{display:flex; align-items:center; justify-content:space-between; padding:12px 2px 0;}
  .tile-cap h3{font-size:14.5px; font-weight:600;}
  .tile-cap span{display:block; font-size:12px; color:var(--ink-soft); margin-top:2px; font-weight:400;}
  .tile-arrow{width:22px;height:22px; border-radius:50%; border:1px solid var(--line); display:flex; align-items:center; justify-content:center; flex:0 0 auto;}
  .tile-arrow svg{width:10px;height:10px; color:var(--ink-soft);}

  /* -------- how to -------- */
  .howto{background:var(--navy); color:#fff; padding:96px 24px;}
  .howto-head{text-align:center; max-width:560px; margin:0 auto 56px;}
  .howto-head h2{font-size:clamp(26px,3.6vw,38px); color:#fff;}
  .howto-head p{color:rgba(245,245,247,.65); margin-top:12px; font-size:14.5px;}
  .howto-grid{max-width:1000px; margin:0 auto; display:grid; grid-template-columns:1fr; gap:40px;}
  @media (min-width:760px){ .howto-grid{grid-template-columns:repeat(3,1fr);} }
  .hitem .num{font-family:'JetBrains Mono',monospace; font-size:13px; color:rgba(245,245,247,.4); margin-bottom:14px;}
  .hitem h4{font-size:17px; font-weight:600; margin-bottom:8px;}
  .hitem p{font-size:13.5px; color:rgba(245,245,247,.62); line-height:1.6; margin:0;}
  .hitem{border-top:1px solid var(--line-on-navy); padding-top:20px;}

  /* -------- footer -------- */
  footer{padding:40px 24px; border-top:1px solid var(--line);}
  .footer-inner{
    max-width:1180px; margin:0 auto; display:flex; justify-content:space-between; align-items:center;
    gap:16px; flex-wrap:wrap; font-size:12.5px; color:var(--ink-soft);
  }
  .footer-brand{display:flex; align-items:center; gap:8px;}
  .footer-brand img{width:20px;height:20px;border-radius:50%;}

  /* reveal */
  [data-reveal]{opacity:0; transform:translateY(28px); transition:opacity .9s var(--ease), transform .9s var(--ease);}
  [data-reveal].in{opacity:1; transform:translateY(0);}

  @media (prefers-reduced-motion: reduce){
    [data-reveal]{opacity:1; transform:none; transition:none;}
    .marquee-track{animation:none;}
  }
</style>
</head>
<body>

<nav class="nav" id="nav">
  <div class="nav-inner">
